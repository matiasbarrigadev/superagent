{
  "name": "superagent",
  "version": "0.7.0",
  "private": true,
  "description": "Agente en WhatsApp sobre Claude Code, autoalojado: un gateway, un panel y WAHA.",
  "type": "module",
  "engines": { "node": ">=24.7" },
  "scripts": {
    "start": "node --no-warnings src/server.mjs",
    "dev": "node --no-warnings --watch src/server.mjs",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "test": "node --no-warnings --test \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/node-ws": "1.3.2",
    "hono": "4.13.21",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4"
  }
}
