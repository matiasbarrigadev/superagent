# Versión de la imagen de Superagent (docker compose). Mejor una fija que "latest": la cambiás cuando quieras.
# Las versiones están en https://github.com/matiasbarrigadev/superagent/releases
SUPERAGENT_VERSION=0.3.0

# Variables opcionales para docker compose. Copiá este archivo a .env y cambiá solo lo que necesites.
# Ninguna es obligatoria: los secretos (WAHA, HMAC, sesión) se generan solos en el primer arranque.
# Nunca pongas acá tokens de Claude, GitHub ni de otros servicios: se conectan desde el panel o por WhatsApp
# y quedan cifrados en el volumen de datos.

# Zona horaria del agente (rutinas, fechas). El agente también la ajusta si se la pedís por WhatsApp.
TZ=UTC

# Dónde escucha el panel en tu máquina. 127.0.0.1 = solo desde esta máquina; 0.0.0.0 = desde la red.
SUPERAGENT_BIND=127.0.0.1
SUPERAGENT_PORT=8080

# URL con la que se arman los links que manda el agente (OAuth, pedidos de variables, aprobaciones).
# Con localhost solo abren en esta máquina. Para el teléfono, usá un dominio o un túnel.
SUPERAGENT_PUBLIC_URL=http://localhost:8080

# HTTPS automático con Caddy (perfil "https"): el dominio tiene que apuntar a este servidor.
# SUPERAGENT_DOMINIO=agente.ejemplo.com

# Código fijo para el setup (si no, se genera uno y aparece en los logs).
# SUPERAGENT_SETUP_CODE=
